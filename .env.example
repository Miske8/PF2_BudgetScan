# BudgetScan — variables d'environnement publiques (Expo)
# Copier ce fichier en `.env` puis adapter les valeurs.

# Environnement applicatif : development | staging | production
EXPO_PUBLIC_APP_ENV=development

# --- OCR (optionnel à terme) ---
# Laisser VIDE pour utiliser le MockOcrService (mode simulation, hors ligne).
# Renseigner une URL + clé pour basculer automatiquement sur RemoteOcrService.
EXPO_PUBLIC_OCR_API_URL=
EXPO_PUBLIC_OCR_API_KEY=
